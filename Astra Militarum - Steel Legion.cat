<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue library="true" id="b090-b976-1f4d-4f81" name="Librarium - Astra Militarum" gameSystemId="sys-ddf1-f1c4-f4c4-87c4" gameSystemRevision="1" revision="1" battleScribeVersion="2.03" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <sharedRules>
    <rule name="Strategy and Initiative" id="cf43-2fdf-281b-652a" hidden="false">
      <description>Steel Legion armies have a Strategy Rating of 2. Collegia Titanica formations have an Initiative Rating of 1+. All other formations have an Initiative Rating of 2+.</description>
      <comment>steel legion</comment>
    </rule>
    <rule name="Lightning Charge" id="3e34-bbbb-eb61-45b9" hidden="false">
      <description>Weapon or Unit gains First Strike during engages initiated by the formation.</description>
    </rule>
    <rule name="Courage, Discipline, and Loyalty" id="651e-ffc3-f771-995b" hidden="false">
      <description>When the Supreme Commander re-roll is used on a formation that contains a Commissar or a Ministorum Priest, the formation counts as having 1+ Initiative Rating when re-rolling the Action Test.</description>
    </rule>
  </sharedRules>
