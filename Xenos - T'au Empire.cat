    <profile name="Manta" typeId="0a48-73e7-5d18-a84d" typeName="Transport" hidden="false" id="4169-8de4-9d64-1df1">
      <characteristics>
        <characteristic name="Capacity" typeId="61b0-a4ea-9433-14e9">12 Infantry/Suits, 8 Skimmers</characteristic>
        <characteristic name="Can Transport:" typeId="c160-32b7-e87e-6bac">Infantry/Suits: Fire Warriors, Pathfinders, XV15 Stealth Battlesuits, XV25 Stealth Battlesuits, Gun Drones, Kroot Warriors, Kroot Master Shapers and Kroot Hounds. Krootox, XV8 Crisis, XV9-04 Hazard, XV88 Broadside and XV95 Ghostkeel Battlesuits counts as two units each
Skimmers: Piranha and Tetra. Devilfish, Hammerhead and Sky Ray counts as two units each. </characteristic>
      </characteristics>
    </profile>
    <profile name="Tiger Shark Bomber" typeId="0a48-73e7-5d18-a84d" typeName="Transport" hidden="false" id="d127-ab5c-7bf5-0580">
      <characteristics>
        <characteristic name="Capacity" typeId="61b0-a4ea-9433-14e9">3 Gun Drones</characteristic>
        <characteristic name="Can Transport:" typeId="c160-32b7-e87e-6bac">Transported Gun Drone formations may be split across multiple Tiger Sharks as an exception to the normal aircraft transport rules. The Tiger Sharks cannot land, Engage, or embark units, but can disembark transported Gun Drones after an approach move. The Gun Drone formation may shoot when it disembarks as normal (see Transporting Ground Units), and counts as having activated for that turn. After this initial deployment the Gun Drones are a completely independent formation.</characteristic>
      </characteristics>
    </profile>
